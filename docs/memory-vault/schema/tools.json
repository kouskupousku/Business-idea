{
  "description": "Muistityökalut. Samat määrittelyt annetaan kaikille kolmelle mallille (Claude, ChatGPT ja Grok tukevat funktiokutsuja JSON Schemalla). Toteutus on sovelluksen palvelimella; mallit eivät koskaan koske tiedostoihin suoraan.",
  "tools": [
    {
      "name": "memory_search",
      "description": "Hae muisteja merkityksen perusteella. Palauttaa VAIN tunnisteet ja lyhyet tiivistelmät (halpa). Lue koko muisti tarvittaessa memory_read-työkalulla.",
      "input_schema": {
        "type": "object", "additionalProperties": false, "required": ["query"],
        "properties": {
          "query": { "type": "string", "description": "Luonnollisen kielen hakulause" },
          "owner": { "enum": ["any", "shared", "claude", "gpt", "grok"], "default": "any" },
          "types": { "type": "array", "items": { "type": "string" } },
          "topic": { "type": "string" },
          "include_archived": { "type": "boolean", "default": false },
          "k": { "type": "integer", "minimum": 1, "maximum": 25, "default": 8 }
        }
      },
      "returns": "[{ id, summary, type, owner, topic, score, tokens }]"
    },
    {
      "name": "memory_read",
      "description": "Lue muistien koko konemuoto (otsake + rungon tietueet). Pyydä vain ne, joita oikeasti tarvitset.",
      "input_schema": {
        "type": "object", "additionalProperties": false, "required": ["ids"],
        "properties": { "ids": { "type": "array", "items": { "type": "string" }, "maxItems": 10 }, "follow_links": { "type": "integer", "minimum": 0, "maximum": 1, "default": 0 } }
      },
      "returns": "[{ id, frontmatter, records: string[] }]"
    },
    {
      "name": "memory_write",
      "description": "Ehdota uutta muistia tai päivitystä. Muistivahti tarkistaa päällekkäisyydet, ristiriidat ja arkaluonteiset tiedot ennen tallennusta. Älä koskaan tallenna salasanoja, API-avaimia tai muita salaisuuksia.",
      "input_schema": {
        "type": "object", "additionalProperties": false, "required": ["type", "summary", "records"],
        "properties": {
          "update_id": { "type": "string", "description": "Jos päivität olemassa olevaa muistia" },
          "type": { "enum": ["fakta", "päätös", "mieltymys", "lähde", "konsensus", "projekti", "havainto", "ristiriita"] },
          "owner": { "enum": ["shared", "self"], "default": "self" },
          "topic": { "type": "string" },
          "summary": { "type": "string", "maxLength": 140 },
          "records": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]\\|" }, "description": "Tiiviit tietueet, ks. README: F|D|P|R|S|C|X|J|O|L|T" },
          "links": { "type": "array", "items": { "type": "string" } },
          "importance": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sources": { "type": "array", "items": { "type": "string" } }
        }
      },
      "returns": "{ id, status: 'created' | 'merged' | 'conflict' | 'rejected', note }"
    },
    {
      "name": "memory_link",
      "description": "Yhdistä kaksi muistia (näkyy galaksissa tähtikuviona).",
      "input_schema": {
        "type": "object", "additionalProperties": false, "required": ["from", "to", "relation"],
        "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "relation": { "enum": ["tukee", "kumoaa", "tarkentaa", "lähde", "liittyy"] } }
      }
    },
    {
      "name": "memory_forget",
      "description": "Arkistoi muisti (siirtyy pölykaistaan). Pysyvän poiston tekee vain käyttäjä.",
      "input_schema": {
        "type": "object", "additionalProperties": false, "required": ["id", "reason"],
        "properties": { "id": { "type": "string" }, "reason": { "type": "string" } }
      }
    }
  ]
}
